# Postgres connection string. This default matches `docker compose up -d` (docker-compose.yml).
DATABASE_URL=postgresql://zedu:zedu_dev_pw@localhost:55432/zedu_sales

# Signs access tokens and setup sessions. Generate with: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Public URL of the app (https://your-domain in production). Used in invite emails.
APP_URL=http://localhost:3000

# Optional bootstrap/admin key (32+ chars). Accepted by /api/admin/* until a key is stored in the database
# (the first key stored through the master-key endpoint replaces it). Lets you create the first admin invite without SQL.
MASTER_KEY=

# Outgoing email (invites, access requests). Leave SMTP_HOST empty in dev to log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Zedu <no-reply@your-domain>"

# Google sign-in (creates Member accounts for new emails). https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
