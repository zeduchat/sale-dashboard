generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  tasks         Task[]

  // Invite-only auth (JWT + refresh tokens). Google sign-in (NextAuth) is only allowed for existing users.
  passwordHash  String?
  role          Role           @default(MEMBER)
  createdAt     DateTime       @default(now())
  disabledAt    DateTime?
  refreshTokens RefreshToken[]
  invitesSent   Invite[]       @relation("InvitedBy")
  inviteId      String?
  invite        Invite?        @relation("AcceptedVia", fields: [inviteId], references: [id], onDelete: SetNull)
  ownedLeads    Lead[]         @relation("LeadOwner")
  createdLeads  Lead[]         @relation("LeadCreator")
  calls         Call[]
  notes         Note[]
  activities    Activity[]
}

enum Role {
  ADMIN
  MEMBER
}

// 9-character setup token, valid for `maxUses` sign-ups (1 for emailed invites). Rows can be inserted by hand, so id and expiresAt have DB-level defaults.
model Invite {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  token       String    @unique
  email       String?
  role        Role      @default(MEMBER)
  expiresAt   DateTime  @default(dbgenerated("(now() + interval '7 days')"))
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  maxUses     Int       @default(1)
  uses        Int       @default(0)
  members     User[]    @relation("AcceptedVia")

  @@index([email])
  @@index([createdAt])
}

// Only the SHA-256 of the opaque refresh token is stored. Rotated on every use; reuse revokes the whole family.
model RefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  familyId     String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

enum AccessRequestStatus {
  PENDING
  INVITED
  DISMISSED
}

model AccessRequest {
  id        String              @id @default(cuid())
  name      String
  email     String
  message   String?
  status    AccessRequestStatus @default(PENDING)
  createdAt DateTime            @default(now())
  handledAt DateTime?

  @@index([status, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum LeadType {
  INDIVIDUAL
  BUSINESS
}

// Pipeline stages in order. LOST is an exit from any stage and needs a lostReason.
enum LeadStatus {
  NEW
  CONTACTED
  CONNECTED
  INTERESTED
  FOLLOW_UP
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LostReason {
  NOT_INTERESTED
  NO_BUDGET
  WRONG_CONTACT
  WENT_WITH_COMPETITOR
  OTHER
}

enum LeadSource {
  MANUAL
  IMPORT
}

enum CallOutcome {
  CONNECTED
  NO_ANSWER
  NOT_INTERESTED
  OTHER
}

enum TaskType {
  CALL
  EMAIL
  FOLLOW_UP
  MEETING
  OTHER
}

enum ActivityType {
  CREATED
  STATUS_CHANGED
  OWNER_CHANGED
  DETAILS_UPDATED
  CALL_LOGGED
  NOTE_ADDED
  TASK_CREATED
}

model Lead {
  id                String      @id @default(cuid())
  /// Human-readable ID, shown as LD-####. Starts at 1001.
  code              Int         @unique @default(autoincrement())
  name              String
  phone             String
  email             String?
  company           String?
  type              LeadType
  status            LeadStatus
  lostReason        LostReason?
  source            LeadSource  @default(MANUAL)
  ownerId           String?
  owner             User?       @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById       String?
  createdBy         User?       @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// Legacy free-text owner from before owners were team members. Read-only fallback for display.
  ownerName         String      @default("")
  /// Legacy next action, superseded by open tasks linked to the lead. Kept for old rows.
  nextAction        String?
  nextActionAt      DateTime?
  /// Latest call (or other logged interaction); denormalised so the list can sort by it.
  lastInteractionAt DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @default(now()) @updatedAt
  calls             Call[]
  tasks             Task[]
  notes             Note[]
  activities        Activity[]

  @@index([createdAt])
  @@index([ownerId])
  @@index([status])
  @@index([lastInteractionAt])
}

model Call {
  id          String      @id @default(cuid())
  leadId      String?
  outcome     CallOutcome
  calledAt    DateTime    @default(now())
  durationSec Int?
  notes       String?
  userId      String?
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  tasks       Task[]
  activities  Activity[]

  @@index([calledAt])
  @@index([leadId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  subtitle    String?
  type        TaskType   @default(OTHER)
  dueAt       DateTime
  done        Boolean    @default(false)
  completedAt DateTime?
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// The call this task was created from ("From call · Oct 14").
  callId      String?
  call        Call?      @relation(fields: [callId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  activities  Activity[]

  @@index([dueAt])
  @@index([leadId])
}

model Note {
  id         String     @id @default(cuid())
  leadId     String
  lead       Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body       String
  createdAt  DateTime   @default(now())
  activities Activity[]

  @@index([leadId, createdAt])
}

/// Lead timeline entry. The optional links point at the call, note or task the entry is about.
model Activity {
  id         String       @id @default(cuid())
  leadId     String
  lead       Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type       ActivityType
  fromStatus LeadStatus?
  toStatus   LeadStatus?
  /// Free text for CREATED ("Added manually · Owner: Agnes Okafor") and OWNER_CHANGED.
  detail     String?
  callId     String?
  call       Call?        @relation(fields: [callId], references: [id], onDelete: Cascade)
  noteId     String?
  note       Note?        @relation(fields: [noteId], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@index([leadId, createdAt])
}

// Single row (id "default"): SHA-hashed bootstrap/admin key, set or rotated via /api/admin/master-key.
model MasterKey {
  id          String   @id @default("default")
  keyHash     String
  version     Int      @default(1)
  rotatedAt   DateTime @default(now())
  rotatedById String?
}
